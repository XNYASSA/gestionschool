// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== USERS & AUTHENTICATION =====

model Utilisateur {
  id             String     @id @default(cuid())
  nom            String
  email          String     @unique
  motDePasse     String
  role           String     // Rôle par défaut (pour compatibilité), ex: SUPER_ADMIN, PRINCIPAL, DIRECTRICE, SECRETAIRE, ENSEIGNANT, ECONOMAT
  fonction       String?    // Intitulé de poste précis, ex: "Censeur", "Surveillant Général"
  telephone      String?
  salaireMensuel Int?       // montant en FCFA
  actif          Boolean    @default(true) // false = ne peut plus se connecter à l'application
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  enseignant         Enseignant?
  utilisateurEcoles  UtilisateurEcole[]      // Permissions par école
  saisiesQuotidiennes SaisieQuotidienne[]   // Saisies du jour
  annoncesCreees     Annonce[] @relation("UtilisateurAnnonces")  // Annonces publiées
  horaires           HoraireTravail[]        // Emploi du temps (jours/heures de travail)
  presences          PresencePersonnel[]     // Présences/absences au travail
  paiementsEffectues Paiement[]              // Encaissements qu'il/elle a réalisés
}

model UtilisateurEcole {
  id           String   @id @default(cuid())
  utilisateur  Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  ecole        Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId      String
  role         String   // SUPER_ADMIN, PRINCIPAL, DIRECTRICE, SURVEILLANT_GENERAL, SECRETAIRE, ENSEIGNANT, ECONOMAT
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([utilisateurId, ecoleId])
}

// ===== SCHOOL STRUCTURE =====

model Ecole {
  id                    String   @id @default(cuid())
  nomCourt              String   @unique // ex: "CRP_FRANCOPHONE", "CBM", "EBSB"
  nomComplet            String   // ex: "Collège Rosa Parks francophone"
  niveau                String   // "SECONDAIRE" ou "MATERNELLE_PRIMAIRE"
  adresse               String   @default("Yaoundé, Cameroun")
  telephone             String   @default("+237 6 XX XXX XXXX")
  email                 String   @default("info@school.cm")
  anneeScolaireEnCours  String   @default("2024-2025")
  actif                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  classes                Classe[]
  matieres               Matiere[]
  personnel              Personnel[]
  configurationsFrais    ConfigurationFrais[]
  utilisateurEcoles      UtilisateurEcole[]
  saisiesQuotidiennes    SaisieQuotidienne[]
  anomaliesDetectees     AnomalieDetetee[]
  annonces               Annonce[]
  parametres             Parametres?
  depenses               Depense[]
  horaires               HoraireTravail[]
  presencesPersonnel     PresencePersonnel[]
}

model Classe {
  id        String   @id @default(cuid())
  nom       String   // ex: "6ème A", "Form 1 B"
  niveau    String   // ex: "6ème", "Form 1"
  ecole     Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  eleves                   Eleve[]
  enseignantClasseMatieres EnseignantClasseMatiere[]
  presences                Presence[]
}

// ===== STUDENTS =====

model Eleve {
  id              String   @id @default(cuid())
  matricule       String   @unique
  nom             String
  prenom          String
  sexe            String   // MASCULIN, FEMININ
  dateNaissance   DateTime
  classe          Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  classeId        String

  // Parent/Tuteur
  nomParent       String
  lieuParente     String?  // Lien: Mère, Père, Tuteur, Oncle, etc.
  telephoneParent String
  emailParent     String?
  adresseParent   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  inscriptionsFrais   InscriptionFrais[]
  notes               Note[]
  presences           Presence[]
  anomaliesDetectees  AnomalieDetetee[]
  bulletins           Bulletin[]
  paiements           Paiement[]
}

// ===== PAYMENTS & FEES =====

model InscriptionFrais {
  id                  String             @id @default(cuid())
  eleve               Eleve              @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId             String
  tranche             String             // "inscription", "tranche1", "tranche2", etc.
  montantDu           Int                // montant en FCFA
  montantPaye         Int    @default(0) // montant payé en FCFA
  modePayement        String?            // ORANGE_MONEY, MTN_MOMO, WAVE, ESPECES, VIREMENT_BANCAIRE
  datePayement        DateTime?
  statut              String @default("IMPAYE") // IMPAYE, PARTIEL, SOLDE
  statutValidation    String @default("BROUILLON") // BROUILLON, VALIDE, REJETE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  paiements           Paiement[]
}

// Journal des opérations d'encaissement (une ligne par versement effectué) —
// alimente les rapports par période et les analyses admin, indépendamment
// du solde cumulé stocké sur InscriptionFrais.
model Paiement {
  id                  String   @id @default(cuid())
  eleve               Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId             String
  inscriptionFrais    InscriptionFrais? @relation(fields: [inscriptionFraisId], references: [id], onDelete: SetNull)
  inscriptionFraisId  String?
  tranche             String   // "inscription", "tranche1", etc. — copie au moment du versement
  montant             Int      // montant versé lors de cette opération (FCFA)
  modePayement        String?
  effectuePar         Utilisateur? @relation(fields: [effectueParId], references: [id], onDelete: SetNull)
  effectueParId       String?
  date                DateTime @default(now())
  createdAt           DateTime @default(now())
}

// ===== TEACHING & GRADES =====

model Enseignant {
  id          String @id @default(cuid())
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String @unique
  telephone   String
  dateEmbauche DateTime @default(now())
  tarifHoraire Int? // FCFA par heure, pour les enseignants payés à l'heure (défini par Principal/Directrice)

  // Relations
  classesMatieres EnseignantClasseMatiere[]
}

model Matiere {
  id             String @id @default(cuid())
  nom            String
  ecole          Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId        String
  coefficient    Int    @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  enseignantClasseMatieres EnseignantClasseMatiere[]
}

model EnseignantClasseMatiere {
  id             String @id @default(cuid())
  enseignant     Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  enseignantId   String
  classe         Classe @relation(fields: [classeId], references: [id], onDelete: Cascade)
  classeId       String
  matiere        Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)
  matiereId      String
  nombreLeconsPrevues Int @default(0) // cible de leçons prévues pour l'année (cahier de textes)
  createdAt      DateTime @default(now())

  // Relations back-reference
  notes          Note[]
  lecons         Lecon[]
}

// ===== CAHIER DE TEXTES =====

model Lecon {
  id        String   @id @default(cuid())
  ecm       EnseignantClasseMatiere @relation(fields: [ecmId], references: [id], onDelete: Cascade)
  ecmId     String
  date      DateTime
  titre     String
  contenu   String?
  createdAt DateTime @default(now())
}

model Note {
  id                 String   @id @default(cuid())
  eleve              Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId            String
  enseignantClasseMatiere EnseignantClasseMatiere @relation(fields: [ecmId], references: [id], onDelete: Cascade)
  ecmId              String
  trimestre          Int      // 1, 2, ou 3
  valeur             Float    // Note sur 20
  observation        String?
  statutValidation   String @default("BROUILLON") // BROUILLON, VALIDE, REJETE
  dateValidation     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ===== ATTENDANCE =====

model Presence {
  id          String   @id @default(cuid())
  eleve       Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId     String
  classe      Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  classeId    String
  date        DateTime
  statut      String   @default("ABSENT") // PRESENT, ABSENT, JUSTIFIE
  observation String?
  createdAt   DateTime @default(now())

  @@unique([eleveId, date])
}

// ===== STAFF & PAYROLL =====

model Personnel {
  id              String   @id @default(cuid())
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  ecoleId         String
  nom             String
  fonction        String   // Directeur, Surveillance, Intendant, etc.
  telephone       String
  salaireMensuel  Int      // montant en FCFA
  dateEmbauche    DateTime @default(now())
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Depense {
  id              String   @id @default(cuid())
  description     String   // ex: "Achat de fournitures", "Réparation toit"
  categorie       String   // MATERIEL, FOURNITURES, MAINTENANCE, ENERGIE, AUTRE
  type            String   @default("VARIABLE") // FIXE ou VARIABLE
  montant         Int      // montant en FCFA
  dateDepense     DateTime @default(now())
  ecole           Ecole?   @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Finance {
  id              String   @id @default(cuid())
  description     String
  montant         Int      // montant en FCFA
  type            String   // ENTREE, SORTIE
  dateTransaction DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ===== FRAIS CONFIGURATION =====

model ConfigurationFrais {
  id             String @id @default(cuid())
  ecole          Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId        String
  montantInscription     Int @default(50000)
  montantFraisTotal      Int @default(80000)
  dateLimiteInscription  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tranches       Tranche[]

  @@unique([ecoleId])
}

model Tranche {
  id                String @id @default(cuid())
  configurationFrais ConfigurationFrais @relation(fields: [configurationFraisId], references: [id], onDelete: Cascade)
  configurationFraisId String
  numero            Int    // 1, 2, 3...
  montant           Int
  dateLimite        DateTime? // date limite de règlement de cette tranche
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([configurationFraisId, numero])
}

// ===== DAILY ENTRIES & ANOMALIES DETECTION =====

model SaisieQuotidienne {
  id            String   @id @default(cuid())
  date          DateTime
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  ecole         Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId       String
  role          String   // PRINCIPAL, DIRECTRICE, SECRETAIRE, ECONOMAT
  type          String   // FRAIS_COLLECTES, DEPENSES_VERIFIEES, BULLETINS, ABSENCES
  donnees       String   // JSON: {montant, description, detailsEleves, etc.}
  validee       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnomalieDetetee {
  id              String   @id @default(cuid())
  date            DateTime
  ecole           Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId         String
  eleve           Eleve?   @relation(fields: [eleveId], references: [id], onDelete: SetNull)
  eleveId         String?
  montant         Int?     // montant en FCFA impliqué
  source1         String   // ex: "SECRETAIRE"
  source2         String   // ex: "PRINCIPAL"
  source3         String?  // ex: "ECONOMAT"
  valeur1         String   // JSON de la donnée source 1
  valeur2         String   // JSON de la donnée source 2
  valeur3         String?  // JSON de la donnée source 3
  ecartsDetectes  String   // JSON: {champ: ecart, ...}
  resolue         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== EMPLOI DU TEMPS & PRÉSENCE DU PERSONNEL =====

model HoraireTravail {
  id            String   @id @default(cuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  ecole         Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId       String
  jour          String   // LUNDI, MARDI, MERCREDI, JEUDI, VENDREDI, SAMEDI
  heureDebut    String   // ex: "08:00"
  heureFin      String   // ex: "16:00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([utilisateurId, jour])
}

model PresencePersonnel {
  id            String   @id @default(cuid())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  ecole         Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId       String
  date          DateTime
  statut        String   @default("PRESENT") // PRESENT, ABSENT, RETARD
  heureArrivee  String?
  heureDepart   String?
  observation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([utilisateurId, date])
}

// ===== ANNOUNCEMENTS =====

model Annonce {
  id            String   @id @default(cuid())
  titre         String
  contenu       String
  ecole         Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  ecoleId       String
  creeePar      Utilisateur @relation("UtilisateurAnnonces", fields: [creeeParId], references: [id], onDelete: Cascade)
  creeeParId    String
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== REPORT CARDS / BULLETINS =====

model Bulletin {
  id              String   @id @default(cuid())
  eleve           Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  eleveId         String
  trimestre       Int      // 1, 2, ou 3
  anneeScolaire   String   // ex: "2024-2025"
  urlPdf          String?  // Chemin ou URL du PDF généré
  dateGeneration  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([eleveId, trimestre, anneeScolaire])
}

// ===== CONFIGURATION =====

model Parametres {
  id                    String  @id @default(cuid())
  ecole                 Ecole   @relation(fields: [ecoleId], references: [id])
  ecoleId               String  @unique
  baremeNotation        String // JSON
  echances              String // JSON
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
